{
  "manifest_version": 3,
  "name": "Verba — AI Writing & Translation",
  "short_name": "Verba",
  "version": "1.0.1",
  "description": "Translate and rewrite text in any box, and right-click selected text to get a simple AI explanation in the side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Verba",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "externally_connectable": {
    "matches": ["https://verba-trans-ai.netlify.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "permissions": ["storage", "alarms", "activeTab", "scripting", "contextMenus", "sidePanel"],
  "host_permissions": [
    "https://verba-api-production.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open Verba translator"
    }
  }
}

# Build-time URLs for the extension. Not secrets.
# Set these as shell environment variables before `npm run build` so every bundle
# (popup/options, content, background) gets the same values, for example:
#   VITE_API_URL=https://your-verba-api.example.com
#   VITE_DASHBOARD_URL=https://your-verba-website.example.com
# Unset, the extension uses localhost defaults (API http://localhost:8787, website http://localhost:5173).
# Known gap: a .env file in this folder is read by the content and background builds only, not by
# the popup/options build, so do not rely on it until vite.config.ts sets envDir.
#VITE_API_URL=https://your-verba-api.example.com
#VITE_DASHBOARD_URL=https://your-verba-website.example.com

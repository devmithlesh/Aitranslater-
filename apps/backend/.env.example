# Verba backend configuration. Copy to .env and adjust. Every variable is optional.

# ── Server ──────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (the dashboard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow any chrome-extension:// origin (the Verba extension).
ALLOW_EXTENSION_ORIGINS=true
# Optional: when set, only these extension IDs may call the API.
# EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop

# Trust X-Forwarded-For (only behind a reverse proxy; affects per-IP rate limits).
TRUST_PROXY=false

# ── Access & encryption ─────────────────────────────────────────────
# Bearer token for every request except /api/health. Leave empty to generate one on first boot
# (saved to DATA_DIR/secrets.json, mode 0600). Minimum 16 characters when set.
# VERBA_ACCESS_TOKEN=
# AES-256-GCM key for stored provider keys: 64 hex chars or base64 of 32 bytes.
# Leave empty to generate one on first boot (saved to DATA_DIR/secrets.json).
# Losing this key makes stored provider keys unreadable; back it up if you set it yourself.
# VERBA_ENCRYPTION_KEY=

# ── Storage ─────────────────────────────────────────────────────────
# file: JSON files in DATA_DIR (default). supabase: Postgres via supabase/schema.sql.
STORAGE=file
DATA_DIR=./data
# Required when STORAGE=supabase (use the service-role key; it stays server-side).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ── Limits ──────────────────────────────────────────────────────────
# Upstream provider call timeout.
REQUEST_TIMEOUT_MS=30000
# Requests per minute per client. AI routes have their own, lower budget.
RATE_LIMIT_AI_PER_MINUTE=30

# Free prompts for visitors who are not signed in (Translate, Ask AI, Reply). Counted per install, per network (IP) and in total per day.
# Set TRUST_PROXY=true behind a proxy (Render), or every visitor shares one network counter. GUEST_DAILY_LIMIT=0 turns guest use off.
GUEST_DAILY_LIMIT=5
GUEST_IP_DAILY_LIMIT=25
GUEST_GLOBAL_DAILY_LIMIT=1000
RATE_LIMIT_PER_MINUTE=300

# ── Translation providers (keys can also be entered in the dashboard) ──
# MyMemory works with no key. Setting a contact email raises the daily quota.
MYMEMORY_EMAIL=
# LibreTranslate: a self-hosted instance (for example http://localhost:5000). Required to enable it.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Azure AI Translator: key and resource region (for example "eastus").
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Google Cloud Translation (Basic v2) API key.
GOOGLE_TRANSLATE_API_KEY=
# DeepL key. Free keys end in ":fx".
DEEPL_API_KEY=

# ── AI model providers ──────────────────────────────────────────────
# Google Gemini (AI Studio key).
GEMINI_API_KEY=
# Groq (OpenAI-compatible).
GROQ_API_KEY=
# OpenRouter (free ":free" models need only this key).
OPENROUTER_API_KEY=
# OpenAI (paid).
OPENAI_API_KEY=
# Ollama running locally, for example http://localhost:11434/v1. Disabled by default.
OLLAMA_BASE_URL=
